</head>
<body>
  <!-- Google Tag Manager (noscript) -->
  <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-MZ6FSXMF"
  height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
  <!-- End Google Tag Manager (noscript) -->

  <div class="aurora" aria-hidden="true"><span></span><span></span><span></span></div>
  <a class="skip" href="#main">Skip to content</a>
  <div class="topbar{% if coverClass == 'cover--home' %} topbar--home{% endif %}">
    <nav class="nav" aria-label="Site">
      <a class="nav-home" href="/">Xuhao Luo</a>
      <ul>
        {%- set indicator = '<span class="nav-indicator" aria-hidden="true"></span>' %}
        <li><a href="/"{% if page.url == "/" %} aria-current="page"{% endif %}>About{% if page.url == "/" %}{{ indicator | safe }}{% endif %}</a></li>
        <li class="nav-group">
          <details>
            {%- set inProjects = page.url.indexOf("/projects/") == 0 %}
            <summary{% if inProjects %} class="is-current"{% endif %}>Project{% if inProjects %}{{ indicator | safe }}{% endif %}</summary>
            <ul class="nav-menu">
              {%- for p in collections.project %}
              <li><a href="{{ p.url }}"{% if page.url == p.url %} aria-current="page"{% endif %}>{{ p.data.title }}</a></li>
              {%- endfor %}
            </ul>
          </details>
        </li>
        <li><a href="/personal/"{% if page.url == "/personal/" %} aria-current="page"{% endif %}>Personal{% if page.url == "/personal/" %}{{ indicator | safe }}{% endif %}</a></li>
        <li>
          <button type="button" class="theme-switch" aria-label="Switch to dark mode" title="Switch to dark mode">
            <span class="to-dark">{% icon "dark" %}</span><span class="to-light">{% icon "light" %}</span>
          </button>
        </li>
      </ul>
    </nav>
  </div>
  {%- set vtSlug = page.url | replace("/", "-") %}
  <header class="cover {{ coverClass }}" style="view-transition-name: cover{{ vtSlug }}">
    {% block cover %}{% endblock %}
  </header>

  <main id="main" style="view-transition-name: main{{ vtSlug }}">
    {% block main %}{% endblock %}
  </main>

  <footer class="footer">
    <p>Xuhao Luo, <a href="mailto:xuhaol2@illinois.edu">xuhaol2@illinois.edu</a></p>
  </footer>

  <script>
    // Close the Project menu on outside click or Escape.
    (function () {
      var menu = document.querySelector('.nav-group details');
      document.addEventListener('click', function (e) { if (!menu.contains(e.target)) menu.open = false; });
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && menu.open) { menu.open = false; menu.querySelector('summary').focus(); }
      });
    })();
    // Keep the aurora in phase with this visit's start time, so each page resumes
    // the ribbons where the previous one left them. It stops while scrolled out of
    // view and is re-synced when it returns or the page comes back from the bfcache.
    (function () {
      var aurora = document.querySelector('.aurora');
      var sync = function () {
        var t = Date.now() - auroraStart;
        aurora.getAnimations({ subtree: true }).forEach(function (a) { a.currentTime = t; });
      };
      sync();
      new IntersectionObserver(function (entries) {
        aurora.classList.toggle('is-paused', !entries[0].isIntersecting);
        if (entries[0].isIntersecting) sync();
      }).observe(aurora);
      addEventListener('pageshow', function (e) { if (e.persisted) sync(); });
    })();
    // Frost the top bar once the page scrolls under it.
    (function () {
      var bar = document.querySelector('.topbar');
      var update = function () { bar.classList.toggle('is-stuck', window.scrollY > 8); };
      update();
      window.addEventListener('scroll', update, { passive: true });
    })();
    // Light/dark switch.
    (function () {
      var btn = document.querySelector('.theme-switch');
      var label = function () {
        var text = document.documentElement.dataset.scheme === 'dark' ? 'Switch to light mode' : 'Switch to dark mode';
        btn.setAttribute('aria-label', text);
        btn.title = text;
      };
      btn.addEventListener('click', function () {
        setTheme(document.documentElement.dataset.scheme === 'dark' ? 'light' : 'dark');
      });
      document.addEventListener('themechange', label);
      label();
    })();
  </script>
  {%- if content.indexOf('class="mermaid"') != -1 %}
  <script type="module">
    import mermaid from "https://cdn.jsdelivr.net/npm/mermaid@10.9.1/dist/mermaid.esm.min.mjs";
    // Keep each diagram's source so it can be redrawn when the theme changes.
    const nodes = [...document.querySelectorAll("pre.mermaid")];
    nodes.forEach((n) => (n.dataset.src = n.textContent));
    const render = () => {
      const dark = document.documentElement.dataset.scheme === "dark";
      mermaid.initialize({ startOnLoad: false, theme: dark ? "dark" : "neutral", fontFamily: "Barlow, sans-serif" });
      nodes.forEach((n) => { n.removeAttribute("data-processed"); n.textContent = n.dataset.src; });
      mermaid.run({ nodes });
    };
    document.addEventListener("themechange", render);
    render();
  </script>
  {%- endif %}
</body>
</html>
