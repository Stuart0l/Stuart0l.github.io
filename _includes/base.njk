<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title == "Xuhao Luo" %}Xuhao Luo{% else %}{{ title }} | Xuhao Luo{% endif %}</title>
  <meta name="description" content="{{ description }}">
  <meta property="og:title" content="{{ title }}">
  <meta property="og:description" content="{{ description }}">
  <meta property="og:url" content="https://www.xuhaol.com{{ page.url }}">
  <link rel="icon" href="/favicon.ico">
  <script>
    // Old docsify links (#/about?id=publication) → new paths.
    (function (h) {
      if (h.indexOf('#/') !== 0) return;
      var parts = h.slice(2).split('?id='), p = parts[0].replace(/\.md$/, '');
      var map = { '': '/', 'about': '/', 'personal': '/personal/', 'Project/hls_expr': '/projects/hls-experience/' };
      if (p in map) location.replace(map[p] + (parts[1] ? '#' + parts[1] : ''));
    })(location.hash);
    // Random hues, same formula as docsify's cover (0–254). They are picked on a
    // reload or a new visit and kept while navigating within the site, along with
    // the aurora's start time so its animation continues across pages.
    (function (s) {
      var saved = null;
      try {
        var nav = performance.getEntriesByType('navigation')[0];
        var internal = document.referrer && new URL(document.referrer).origin === location.origin;
        if (nav && nav.type !== 'reload' && internal) saved = JSON.parse(sessionStorage.getItem('aurora'));
      } catch (e) {}
      if (!saved) {
        saved = { h1: Math.floor(Math.random() * 255), h2: Math.floor(Math.random() * 255), t0: Date.now() };
        try { sessionStorage.setItem('aurora', JSON.stringify(saved)); } catch (e) {}
      }
      s.setProperty('--h1', saved.h1);
      s.setProperty('--h2', saved.h2);
      window.auroraStart = saved.t0;
    })(document.documentElement.style);
    // Theme: an explicit choice from the switch (localStorage) wins; otherwise follow the system.
    // data-theme = explicit choice, data-scheme = the scheme in effect.
    (function (root) {
      var mq = matchMedia('(prefers-color-scheme: dark)');
      var stored = function () { try { return localStorage.getItem('theme'); } catch (e) { return null; } };
      window.applyTheme = function () {
        var t = stored();
        if (t) root.dataset.theme = t; else delete root.dataset.theme;
        root.dataset.scheme = t || (mq.matches ? 'dark' : 'light');
        document.dispatchEvent(new Event('themechange'));
      };
      window.setTheme = function (next) {
        try {
          // Choosing the system's own scheme goes back to following the system.
          if (next === (mq.matches ? 'dark' : 'light')) localStorage.removeItem('theme');
          else localStorage.setItem('theme', next);
        } catch (e) {}
        applyTheme();
      };
      mq.addEventListener('change', applyTheme);
      applyTheme();
    })(document.documentElement);
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600&family=Barlow:wght@400;500;600&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400;1,8..60,600&display=swap">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Serif+SC:wght@500&text=%E7%BD%97%E6%97%AD%E7%9A%93&display=swap">
  <link rel="stylesheet" href="/assets/site.css">

  <!-- Google Tag Manager -->
  <script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
  new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
  j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
  'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
  })(window,document,'script','dataLayer','GTM-MZ6FSXMF');</script>
  <!-- End Google Tag Manager -->

  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-4R54FC66XX"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-4R54FC66XX');
